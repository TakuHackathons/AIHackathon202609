{
  "name": "empathy-ai-companion-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "tsc",
    "deploy:cloudflare": "wrangler deploy",
    "lint": "tsc --noEmit",
    "test:orca:e2e": "tsx scripts/test-orca-e2e.ts",
    "wrangler": "wrangler",
    "format": "prettier --config .prettierrc --write \"src/**/*.{ts,js}\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:drop:all:local": "node --no-warnings --import tsx scripts/drop-local-db.ts",
    "db:migrate:reset": "pnpm run db:drop:all:local && pnpm run db:migrate:local",
    "db:seed:local": "node --no-warnings --import tsx scripts/seed-admin.ts",
    "db:seed:remote": "wrangler d1 execute DB --remote --file seeds/admin.sql",
    "delete:school": "tsx scripts/delete-school.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@simplewebauthn/server": "^14.0.2",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.2.1",
    "hono": "^4.12.23",
    "openai": "^7.20.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.95.0"
  }
}
